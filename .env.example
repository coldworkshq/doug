# Two dotenv files, and they are read by different halves of the repo.
#
#   api/.env   The Python service. NOT loaded automatically — `uv run` ignores
#              a dotenv unless it is named. `make api-dev` and `make dev` pass
#              `--env-file .env` when the file exists; otherwise export the
#              variables in your shell. `make test` deliberately does not load
#              it. Everything under "API" below belongs here.
#
#   .env       The repo root. Next.js loads this on its own, so `web/` and
#              `console/` pick it up with no wiring. The "Web" line belongs
#              here.
#
# Both are gitignored. Neither is read by a deployed service: production reads
# environment variables set by api/deploy/gcp.sh, and secrets from Google
# Secret Manager. See docs/OPERATIONS.md.

# --- API (api/.env) ----------------------------------------------------------
DOUG_THRESHOLD=0.62
GITHUB_WEBHOOK_SECRET=
DOUG_CORS_ORIGINS=http://localhost:3000

# Langfuse tracing (ADR-0031). Off unless DOUG_TRACING=1 AND both keys are
# set; any one of the three missing means off, never partly on.
#
# With it on, a span carries the exact bytes the model was sent — the system
# prompt and the diff slice — and the exact text it sent back. Point it at
# your own project, and do not turn it on against a checkout holding someone
# else's private code.
DOUG_TRACING=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU).
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Which population a span belongs to. `local` here, `production` on the
# deployed service. Without it every span carries the SDK's `default` and a
# trace holding your own repository is indistinguishable from one holding a
# tenant's private diff — which cannot be fixed after the fact, because
# nothing on an untagged span says which it was. Lowercase letters, digits,
# hyphens and underscores; it must not start with `langfuse`.
LANGFUSE_TRACING_ENVIRONMENT=local

# --- Web (.env) --------------------------------------------------------------
# Where the queue page finds the API.
DOUG_API_URL=http://localhost:8000
